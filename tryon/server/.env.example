# Copy to server/.env and fill in at least one engine.

# Google Gemini image model: renders a whole layered outfit (incl. shoes/bags) in one call.
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# FASHN dedicated try-on API (tops / bottoms / one-pieces), layered by chaining.
FASHN_API_KEY=
# FASHN_MODEL=tryon-v1.6
# FASHN_MODE=balanced

# Self-hosted open-source model wrapper (CatVTON / IDM-VTON / Leffa ...), see README.
# SELFHOST_URL=http://your-gpu-box:9000/tryon

# PORT=8787
